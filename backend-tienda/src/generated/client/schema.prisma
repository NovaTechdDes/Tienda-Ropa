// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
}

datasource db {
  provider = "postgresql"
}

model Cliente {
  id          Int      @id @default(autoincrement())
  nombre      String
  telefono    String?
  dni         String?
  direccion   String?
  localidad   String?
  observacion String?  @default("-")
  activo      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Marca {
  id     Int    @id @default(autoincrement())
  nombre String @unique
}

model Provedor {
  id     Int    @id @default(autoincrement())
  nombre String @unique
}

model Talle {
  id     Int    @id @default(autoincrement())
  nombre String @unique

  variantes variante_producto[]
}

model Categoria {
  id     Int    @id @default(autoincrement())
  nombre String @unique
}

model Color {
  id     Int    @id @default(autoincrement())
  nombre String @unique

  variantes variante_producto[]
}

model Producto {
  id           Int      @id @default(autoincrement())
  descripcion  String
  provedor_id  Int?
  marca_id     Int?
  categoria_id Int?
  sku          String?
  img_url      String?
  observacion  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  activo       Boolean  @default(true)

  variantes variante_producto[]
}

model variante_producto {
  id          Int      @id @default(autoincrement())
  producto_id Int
  talle_id    Int
  color_id    Int
  precio      Float
  stock       Int
  sku         String?
  activo      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  producto Producto @relation(fields: [producto_id], references: [id])
  talle    Talle    @relation(fields: [talle_id], references: [id])
  color    Color    @relation(fields: [color_id], references: [id])
}

model Venta {
  id           Int      @id @default(autoincrement())
  cliente_id   Int
  fecha        DateTime @default(now())
  total        Float
  observacion  String?
  numero_venta String   @unique
  tipo_pago    String
  tipo_venta   String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model detalle_venta {
  id          Int      @id @default(autoincrement())
  venta_id    Int
  variante_id Int
  cantidad    Int
  precio      Float
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model stock_movimiento {
  id          Int      @id @default(autoincrement())
  variante_id Int
  tipo        String
  cantidad    Int
  referencia  String?
  fecha       DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
